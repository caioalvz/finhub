rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Código de convite: quem tem o código consegue ler (get), ninguém lista.
    match /invites/{code} {
      allow get, create: if signedIn();
    }

    match /households/{hid} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }
      // Entrar no grupo: só acrescenta o próprio uid em members/memberNames.
      function isJoining() {
        return signedIn()
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames']);
      }

      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow read: if isMember();
      allow update: if isMember() || isJoining();

      match /{sub}/{docId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
      }
    }
  }
}
